{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"OCARINA WILD Biodiversity Record",
 "type":"object",
 "required":["id","type","name","latin","status","statusLabel"],
 "properties":{
  "id":{"type":"string"},"type":{"enum":["fauna","flora"]},"group":{"type":"string"},
  "name":{"type":"string"},"latin":{"type":"string"},
  "status":{"enum":["documentado","observado","pendiente","referencia"]},"statusLabel":{"type":"string"},
  "environment":{"type":"string"},"note":{"type":"string"},"image":{"type":"string"},"imageCredit":{"type":"string"},
  "sourceRef":{"type":"string"},"date":{"type":"string"},"count":{"type":"string"},
  "lat":{"type":"number"},"lng":{"type":"number"},"coordinateUncertaintyInMeters":{"type":"number"},
  "hideLocation":{"type":"boolean"},"randomEligible":{"type":"boolean"}
 },
 "additionalProperties":true
}